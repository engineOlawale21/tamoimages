NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=15m
JWT_ISSUER=tamo-identity
JWT_AUDIENCE=tamo-platform
EMAIL_VERIFICATION_TTL=30m
PASSWORD_RECOVERY_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_IDLE_TTL=7d
RATE_LIMIT_HMAC_SECRET=replace-with-a-different-32-character-secret
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
JSON_BODY_LIMIT=100kb
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000
DATABASE_URL=postgresql://tamo_identity:identity_local_only@localhost:5433/tamo_identity
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
KAFKA_BROKERS=localhost:9092
KAFKA_CONNECT_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=5000
