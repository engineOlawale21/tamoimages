{
  "name": "tamo-images-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "tamo-auth-service",
    "tamo-web"
  ],
  "scripts": {
    "infra:config": "docker compose --file tamo-infrastructure/docker-compose.yml config --quiet",
    "infra:up": "docker compose --file tamo-infrastructure/docker-compose.yml up --detach",
    "infra:down": "docker compose --file tamo-infrastructure/docker-compose.yml down",
    "infra:trim": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-maintenance.ps1",
    "auth:dev": "npm run start:dev --workspace tamo-auth-service",
    "auth:build": "npm run build --workspace tamo-auth-service",
    "auth:test": "npm test --workspace tamo-auth-service",
    "web:dev": "npm run dev --workspace tamo-web",
    "web:build": "npm run build --workspace tamo-web",
    "web:test": "npm test --workspace tamo-web",
    "media:build": "go -C tamo-media-service build ./...",
    "media:test": "go -C tamo-media-service test ./...",
    "verify:js": "node scripts/verify-js.mjs",
    "verify:go": "go -C tamo-media-service vet ./... && go -C tamo-media-service test ./... && go -C tamo-media-service build ./...",
    "contracts:validate": "node scripts/validate-openapi.mjs",
    "verify": "npm run infra:config && npm run contracts:validate && npm run verify:js && npm run verify:go"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  }
}
